 src/home/homed-manager-bus.c | 76 ++++++++++++++++++++++++++----------
 src/home/homed-manager.c     | 50 +++++++++++++++++++-----
 src/home/homed-manager.h     |  2 +
 src/home/homed-varlink.c     | 28 +++++++------
 8 files changed, 154 insertions(+), 54 deletions(-)


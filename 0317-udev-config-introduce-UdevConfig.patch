 src/udev/udev-manager.h |  13 ++--
 src/udev/udev-spawn.c   |  14 ++--
 src/udev/udev-worker.c  |   4 +-
 src/udev/udev-worker.h  |   7 +-
 8 files changed, 142 insertions(+), 101 deletions(-)

